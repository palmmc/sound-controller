{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contributors": [
        "BVengo",
        "JustAlittleWolf",
        "YouQi-ovo",
        "Maganoos",
        "lonefelidae16",
        "eikhren",
        "CoolAid48"
    ],
    "contact": {
        "sources": "https://github.com/palmmc/sound-controller",
        "issues": "https://github.com/palmmc/sound-controller/issues"
    },
    "license": "${license}",
    "icon": "assets/${mod_id}/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "com.bvengo.soundcontroller.SoundControllerFabric"
        ],
        "modmenu": [
            "com.bvengo.soundcontroller.config.ModMenuIntegration"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": ">=26.1",
        "java": ">=${java_version}"
    },
    "recommends": {
        "modmenu": "*"
    }
}